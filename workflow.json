      "id": "webhook-node",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "lead-intake"
    },
    {
      "parameters": {
        "jsCode": "// Lead Router — обработка и роутинг лида\n\nfunction normalizeText(value) {\n  return String(value ?? '').trim();\n}\n\nfunction normalizeEmail(value) {\n  return normalizeText(value).toLowerCase();\n}\n\nfunction normalizePhone(value) {\n  return normalizeText(value).replace(/[^\\d+]/g, '');\n}\n\n// Получаем данные из Webhook\n// В режиме \"Run Once for All Items\" данные доступны через items\nconst results = [];\n\nfor (const item of items) {\n  const input = item.json;\n\n  const lead = {\n    name: normalizeText(input.name),\n    email: normalizeEmail(input.email),\n    phone: normalizePhone(input.phone),\n    priority: normalizeText(input.priority) || 'normal',\n    message: normalizeText(input.message),\n    submitted_at: input.submitted_at || new Date().toISOString(),\n    hasEmail: normalizeEmail(input.email).length > 0,\n    hasPhone: normalizePhone(input.phone).length > 0,\n    isHighPriority: ['high', 'urgent'].includes(normalizeText(input.priority)),\n    writeToSheet: true,\n    notifyTelegram: true,\n    sendEmail: normalizeEmail(input.email).length > 0,\n  };\n\n  results.push({ json: lead });\n}\n\nreturn results;\n",
        "mode": "runOnceForAllItems"
      },
      "id": "lead-router-node",
      "name": "Lead Router",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
