            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n11",
      "name": "Prepare Cancel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        600
      ],
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst chatId = data.chatId;\nconst cancelTime = data.cancelTime;\n\nif (!cancelTime) {\n  return [{\n    json: {\n      chatId,\n      error: true,\n      responseText: '❌ Укажите время для отмены. Пример: /cancel 11:30',\n      cancelTime: null,\n      dateStr: null\n    }\n  }];\n}\n\nconst timeRegex = /^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$/;\nif (!timeRegex.test(cancelTime)) {\n  return [{\n    json: {\n      chatId,\n      error: true,\n      responseText: '❌ Неверный формат времени. Пример: /cancel 11:30',\n      cancelTime: null,\n      dateStr: null\n    }\n  }];\n}\n\nconst now = new Date();\nconst moscowDate = new Date(now.getTime() + 3 * 60 * 60 * 1000);\nconst dateStr = moscowDate.toISOString().split('T')[0];\n\nreturn [{\n  json: {\n    chatId,\n    error: false,\n    cancelTime,\n    dateStr\n  }\n}];"
      }
    },
    {
      "id": "n12",
      "name": "Read For Cancel",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        1000,
        600
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "SHEETS_CRED",
          "name": "Google Sheets"
        }
      },
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Bookings",
          "mode": "name"
        },
        "filtersUI": {},
        "options": {}
      }
    },
    {
      "id": "n13",
      "name": "Cancel Booking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        600
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const allItems = $input.all();\nconst prepData = $('Prepare Cancel').first().json;\nconst { chatId, cancelTime, dateStr, error } = prepData;\n\nif (error) {\n  return [{ json: { chatId, found: false, responseText: prepData.responseText, cancelTime, dateStr } }];\n}\n\nconst booking = allItems.find(item =>\n  item.json.date === dateStr &&\n  item.json.time === cancelTime &&\n  item.json.horse_name &&\n  item.json.horse_name.trim() !== '' &&\n  item.json.horse_name !== '[ОТМЕНЕНО]'\n);\n\nif (!booking) {\n  return [{\n    json: {\n      chatId,\n      found: false,\n      responseText: `❌ Запись на ${cancelTime} не найдена или уже отменена.`,\n      cancelTime,\n      dateStr\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    chatId,\n    found: true,\n    dateStr,\n    cancelTime,\n    horseName: booking.json.horse_name,\n    responseText: `✅ Запись лошади «${booking.json.horse_name}» на ${cancelTime} отменена.`\n  }\n}];"
      }
    },
    {
      "id": "n14",
      "name": "Update Cancelled",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        1500,
        600
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "SHEETS_CRED",
          "name": "Google Sheets"
        }
      },
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Bookings",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "date": "={{ $json.dateStr }}",
            "time": "={{ $json.cancelTime }}",
            "horse_name": "[ОТМЕНЕНО]"
          }
        },
        "matchingColumns": [
          "date",
          "time"
        ],
        "options": {}
      }
    },
    {
      "id": "n15",
      "name": "Send Cancel Confirm",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1750,
        600
      ],
      "credentials": {
